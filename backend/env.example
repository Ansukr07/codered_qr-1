PORT=5000
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
NFC_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
PUBLIC_APP_URL=http://localhost:5173
SUBMISSIONS_OPEN=false
# JSON array: [{"label":"Day 1","date":"2026-12-12","events":[{"time":"09:30","title":"Opening ceremony","location":"Auditorium"}]}]
EVENT_SCHEDULE_JSON=[]
# Existing participant used only by the optional read-only `npm run smoke:live` verification.
SMOKE_PARTICIPANT_ID=
SMOKE_PARTICIPANT_EMAIL=
