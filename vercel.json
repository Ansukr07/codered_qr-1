{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix backend && npm ci --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/index.js?route=$1"},
    {"handle": "filesystem"},
    {"src": "/.*", "dest": "/index.html"}
  ]
}
