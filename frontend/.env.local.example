JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Optional dedicated AES key for recoverable NFC backup QR URLs. If omitted,
# JWT_SECRET is used. Set a stable secret before issuing production tags.
NFC_TOKEN_ENCRYPTION_KEY=your-separate-long-random-nfc-encryption-secret
# Optional one-time NFC pilot account seeding. Keep real passwords local.
DEMO_ADMIN_EMAIL=demo.admin@codered.local
DEMO_ADMIN_PASSWORD=choose-a-strong-temporary-password
DEMO_VOLUNTEER_EMAIL=demo.volunteer@codered.local
DEMO_VOLUNTEER_PASSWORD=choose-a-different-strong-temporary-password
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
